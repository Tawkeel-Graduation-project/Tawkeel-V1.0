# Copy to .env and replace each placeholder with local development values.
APP_ENV=replace_with_environment_name
LOG_LEVEL=replace_with_log_level
DATABASE_URL=postgresql://replace_with_user:replace_with_url_safe_password@localhost:5432/replace_with_database

# PostgreSQL values consumed by Docker Compose. Use a URL-safe password.
POSTGRES_DB=replace_with_database
POSTGRES_USER=replace_with_user
POSTGRES_PASSWORD=replace_with_url_safe_password
POSTGRES_PORT=5432
